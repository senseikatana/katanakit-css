---
// ============================================================
//  VersionTitle.astro — override del Title de Starlight que
//  añade un selector de versiones de la documentación.
// ============================================================
const versions = [
  { path: '/', label: 'latest' },
  { path: '/versions/0-1-0/', label: 'v0.1.0' },
];
// Comprueba primero las rutas más específicas (versiones) para no
// marcar "latest" en páginas versionadas (prefijo común).
const current =
  [...versions]
    .sort((a, b) => b.path.length - a.path.length)
    .find((v) => Astro.url.pathname.startsWith(v.path)) ?? versions[0];
---
<div class="kk-version-title">
  <a href="/" class="kk-version-title__link">KatanaKIT CSS</a>
  <select
    class="kk-version-select"
    aria-label="Documentation version"
    onchange="window.location.href = this.value"
  >
    {
      versions.map((v) => (
        <option value={v.path} selected={v.path === current.path}>
          {v.label}
        </option>
      ))
    }
  </select>
</div>

<style>
  .kk-version-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .kk-version-title__link {
    font-weight: 600;
    color: inherit;
    text-decoration: none;
  }
  .kk-version-select {
    font-size: 0.8125rem;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
  }
</style>
