---
// ============================================================
//  VersionTitle.astro — SiteTitle override.
//  Shows the logo + a version dropdown that reads from
//  site/src/content/versions.json.
// ============================================================
import versions from '../content/versions.json';

// Find the most specific matching path (longest first) so that
// "/versions/0-1-0/" wins over "/" when inside a versioned page.
const sorted = [...versions].sort((a, b) => b.path.length - a.path.length);
const current = sorted.find((v) => Astro.url.pathname.startsWith(v.path)) ?? versions[0];
---
<div class="kk-version-title">
  <a href="/" class="kk-version-title__link">KatanaKIT CSS</a>
  {versions.length > 1 && (
    <select
      class="kk-version-select"
      aria-label="Documentation version"
      onchange="window.location.href = this.value"
    >
      {versions.map((v) => (
        <option value={v.path} selected={v.tag === current.tag}>
          {v.label}
        </option>
      ))}
    </select>
  )}
  {versions.length === 1 && (
    <span class="kk-version-badge">{versions[0].label}</span>
  )}
</div>

<style>
  .kk-version-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .kk-version-title__link {
    font-weight: 600;
    color: inherit;
    text-decoration: none;
  }
  .kk-version-select {
    font-size: 0.8125rem;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    cursor: pointer;
  }
  .kk-version-badge {
    font-size: 0.75rem;
    padding: 0.125rem 0.5rem;
    border-radius: 9999px;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent);
    font-weight: 500;
  }
</style>
