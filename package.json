{
  "name": "katanakit-css",
  "version": "0.1.0",
  "scripts": {
    "build:css": "sass src/scss/main.scss:dist/css/main.css --no-source-map --style=compressed",
    "build:css:dev": "sass src/scss/main.scss:dist/css/main.css --watch",
    "build:purge": "postcss dist/css/main.css -o dist/css/main.min.css",
    "build": "bun run build",
    "dev": "bun run dev",
    "test": "bun run test"
  },
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.5",
    "live-server": "^1.2.2",
    "postcss": "^8.5.26",
    "postcss-cli": "^11.0.1",
    "sass": "^1.103.0"
  },
  "author": "senseikatana - Sergio Jurado",
  "description": "Proyecto katanakit-css",
  "main": "index.js",
  "license": "MIT"
}
