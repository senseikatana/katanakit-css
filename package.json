{
  "name": "katanakit-css",
  "version": "0.4.2",
  "description": "KatanaKIT CSS — a lightweight, modular SCSS mini-framework: design tokens, utility classes and layout mixins (grid, flex, breakpoints) with a @apply-style system. Zero runtime overhead.",
  "keywords": [
    "scss",
    "sass",
    "css",
    "framework",
    "design-tokens",
    "utility-classes",
    "mixins",
    "grid",
    "flexbox",
    "breakpoints",
    "reset",
    "purgecss",
    "vite"
  ],
  "license": "MIT",
  "author": "senseikatana - Sergio Jurado",
  "repository": {
    "type": "git",
    "url": "git@github.com:senseikatana/katanakit-css.git"
  },
  "homepage": "https://github.com/senseikatana/katanakit-css#readme",
  "bugs": {
    "url": "https://github.com/senseikatana/katanakit-css/issues"
  },
  "files": [
    "src/scss",
    "dist/css",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sass": "src/scss/main.scss",
  "style": "dist/css/katanakit.css",
  "scripts": {
    "dev": "astro dev --root site --port 4321",
    "build": "npm run build:css && astro build --root site",
    "build:css": "sass src/scss/main.scss dist/css/katanakit.css --no-source-map --style=compressed",
    "preview": "astro preview --root site",
    "demo": "vite --config vite.config.mts",
    "demo:build": "vite build --config vite.config.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.42.0",
    "@types/node": "^26.4.1",
    "astro": "^7.3.1",
    "autoprefixer": "^10.5.5",
    "postcss": "^8.5.26",
    "sass": "^1.103.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-purgecss": "^0.2.13",
    "vitest": "^5.0.0"
  }
}
